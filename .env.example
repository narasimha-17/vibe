# ── Shared / infra ────────────────────────────────────────────────
POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibe
POSTGRES_DB=vibe
DATABASE_URL=postgresql+asyncpg://vibe:vibe@localhost:5432/vibe

# ── apps/api ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
STORAGE_DIR=./storage

# OAuth login (optional — login buttons show "not configured" until set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI (optional — use `AI_PROVIDER=ollama` for a local Ollama model)
# OpenRouter: when the key is set, OORA and copy rewriting use this model ahead of Ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Build agents (API, UI, Backend, Integration, Testing) start automatically after OORA creates a project
AGENTS_AUTO_BUILD=true
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# Billing (optional — upgrade button disabled until set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# ── apps/web ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
